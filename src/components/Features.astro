---
import ArticleCard from './ArticleCard.astro';
import { newsSection } from '../data/homepage';
---
<section class="features section section--sm" id="nieuws">
  <div class="container">
    <header class="features__header reveal">
      <h4 class="section-title">{newsSection.title}</h4>
      <p>{newsSection.description}</p>
    </header>
    <div class="card-grid card-grid--3">
      {newsSection.items.map((item) => (
        <ArticleCard {...item} />
      ))}
    </div>
  </div>
</section>

<style>
  .features__header {
    margin-bottom: 2.25rem;
    max-width: 72ch;
  }

  .features__header p {
    color: var(--color-text);
    margin: 0;
  }
</style>
