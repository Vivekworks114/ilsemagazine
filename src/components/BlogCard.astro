---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;

function formatDate(date: Date): string {
  const months = [
    'januari', 'februari', 'maart', 'april', 'mei', 'juni',
    'juli', 'augustus', 'september', 'oktober', 'november', 'december',
  ];
  return `${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
}

const slug = entry.id;
const image = entry.data.featuredImage ?? '/images/2022/Rectangle-1-1.png';
const imageAlt = entry.data.imageAlt ?? entry.data.title;
const postUrl = `/${slug}/`;
---
<article class="blog-card reveal">
  <a href={postUrl} class="blog-card__link">
    <div class="blog-card__image-wrap">
      <img
        src={image}
        alt={imageAlt}
        class="blog-card__image"
        width="800"
        height="450"
        loading="lazy"
      />
    </div>
    <div class="blog-card__content">
      <h3>{entry.data.title}</h3>
      <time class="blog-card__date" datetime={entry.data.pubDate.toISOString()}>
        {formatDate(entry.data.pubDate)}
      </time>
      <p>{entry.data.description}</p>
    </div>
  </a>
</article>

<style>
  .blog-card__link {
    display: block;
    transition: transform var(--transition);
  }

  .blog-card__link:hover {
    transform: translateY(-4px);
  }

  .blog-card__link:hover .blog-card__image {
    transform: scale(1.04);
  }

  .blog-card__image-wrap {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    margin-bottom: 1rem;
    background: var(--color-bg-warm);
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .blog-card__content h3 {
    font-size: 1.25rem;
    margin-bottom: 0.35rem;
    line-height: 1.25;
  }

  .blog-card__date {
    display: block;
    font-family: var(--font-nav);
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }

  .blog-card__content p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
