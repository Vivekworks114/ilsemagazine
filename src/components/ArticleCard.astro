---
interface Props {
  title: string;
  href: string;
  image: string;
  alt: string;
  variant?: 'default' | 'compact';
}

const { title, href, image, alt, variant = 'default' } = Astro.props;
---
<article class:list={['article-card', 'reveal', variant === 'compact' && 'article-card--compact']}>
  <a href={href} class="article-card__link">
    <div class="article-card__image-wrap">
      <img src={image} alt={alt} width={800} height={450} loading="lazy" class="article-card__image" />
    </div>
    <h3 class="article-card__title">{title}</h3>
  </a>
</article>

<style>
  .article-card__link {
    display: block;
    transition: opacity var(--transition);
  }

  .article-card__link:hover {
    opacity: 0.85;
  }

  .article-card__link:hover .article-card__image {
    transform: scale(1.03);
  }

  .article-card__image-wrap {
    overflow: hidden;
    margin-bottom: 1rem;
    background: var(--color-bg-warm);
    aspect-ratio: 16 / 10;
  }

  .article-card--compact .article-card__image-wrap {
    height: 215px;
    aspect-ratio: unset;
  }

  .article-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .article-card__title {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    margin: 0;
    line-height: 1.2;
    transition: opacity var(--transition);
  }

  .article-card--compact .article-card__title {
    font-size: clamp(1.125rem, 1.8vw, 1.625rem);
  }
</style>
