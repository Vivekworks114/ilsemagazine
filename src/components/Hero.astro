---
import { heroContent } from '../data/homepage';
---
<section class="hero">
  <div class="hero__inner">
    <div class="hero__media reveal">
      <img
        src={heroContent.image}
        alt={heroContent.imageAlt}
        width={710}
        height={608}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__content reveal">
      <h1>{heroContent.title}</h1>
      <p>{heroContent.description}</p>
      <a href={heroContent.ctaHref} class="btn">
        {heroContent.ctaLabel}
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M1 5H13M9 1L13 5L9 9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: min(70vh, 640px);
  }

  .hero__media {
    position: relative;
    overflow: hidden;
    min-height: 0;
  }

  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4.5rem) clamp(2rem, 6vw, 5rem);
  }

  .hero__content h1 {
    margin-bottom: 1.5rem;
  }

  .hero__content p {
    margin-bottom: 1.25rem;
    line-height: 1.55;
    max-width: 38ch;
  }

  @media (max-width: 767px) {
    .hero__inner {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero__media {
      min-height: min(55vw, 320px);
      aspect-ratio: 710 / 608;
    }

    .hero__content {
      padding: 2rem 1.25rem 2.5rem;
    }

    .hero__content p {
      max-width: none;
    }
  }
</style>
