---
import { heroContent } from '../data/homepage';
---
<section class="hero section section--gradient section--gradient-top">
  <div class="hero__inner container">
    <div class="hero__media reveal">
      <img
        src={heroContent.image}
        alt={heroContent.imageAlt}
        width={710}
        height={608}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__content reveal">
      <h1>{heroContent.title}</h1>
      <p>{heroContent.description}</p>
      <a href={heroContent.ctaHref} class="btn">
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M13 5H1M9 1L13 5L9 9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {heroContent.ctaLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__media img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .hero__content {
    max-width: 65%;
  }

  .hero__content h1 {
    margin-bottom: 1.5rem;
  }

  .hero__content p {
    margin-bottom: 0.875rem;
    line-height: 1.2;
  }

  @media (max-width: 767px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__media {
      order: -1;
    }

    .hero__content {
      max-width: 100%;
      padding-inline: 0.625rem;
    }
  }
</style>
