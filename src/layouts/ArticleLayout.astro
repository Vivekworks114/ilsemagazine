---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  image: string;
  date?: string;
}

const { title, description, image, date } = Astro.props;
---
<BaseLayout title={title} description={description} image={image}>
  <slot name="header" slot="header" />
  <article class="article">
    <div class="article__layout container">
      <header class="article__header reveal">
        <nav class="page-breadcrumbs" aria-label="Breadcrumb">
          <ol class="page-breadcrumbs__list">
            <li class="page-breadcrumbs__item"><a class="page-breadcrumbs__link" href="/">Home</a></li>
            <li class="page-breadcrumbs__sep" aria-hidden="true">›</li>
            <li class="page-breadcrumbs__item" aria-current="page">
              <span class="page-breadcrumbs__current">{title}</span>
            </li>
          </ol>
        </nav>

        {date && (
          <time datetime={date}>
            {new Date(date).toLocaleDateString('nl-NL', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        )}
        <h1>{title}</h1>
        {description && <p class="article__excerpt">{description}</p>}
      </header>

      <div class="article__hero reveal">
        <img
          src={image}
          alt={title}
          width={1200}
          height={675}
          loading="eager"
          class="article__image"
        />
      </div>

      <div class="article__body prose reveal">
        <slot />
      </div>
    </div>
  </article>
  <slot name="footer" slot="footer" />
</BaseLayout>

<style>
  .article {
    padding-block: clamp(1.75rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .article__layout {
    max-width: min(760px, 100%);
  }


  .article__header time {
    display: block;
    font-family: var(--font-nav);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .article__header h1 {
    font-size: clamp(1.875rem, 4.2vw, 2.75rem);
    letter-spacing: -0.01em;
    max-width: 22ch;
    margin-bottom: 0.75rem;
  }

  .article__excerpt {
    font-size: 1.125rem;
    color: var(--color-muted);
    max-width: 60ch;
    margin: 0;
    line-height: 1.6;
  }

  .article__hero {
    margin-block: 2rem 2.5rem;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-bg-warm);
  }

  .article__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .article__hero:hover .article__image {
    transform: scale(1.02);
  }

  .article__body {
    max-width: none;
    line-height: 1.75;
    font-size: clamp(1rem, 1.4vw, 1.0625rem);
  }

  @media (max-width: 599px) {
    .article__header h1 {
      max-width: none;
    }

    .article__hero {
      aspect-ratio: 4 / 3;
    }
  }
</style>
