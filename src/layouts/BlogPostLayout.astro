---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { shouldShowFeaturedImage, isUsableFeaturedImage } from '../lib/featured-image';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;

function formatDate(date: Date): string {
  const months = [
    'januari', 'februari', 'maart', 'april', 'mei', 'juni',
    'juli', 'augustus', 'september', 'oktober', 'november', 'december',
  ];
  return `${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
}

const featuredImage = entry.data.featuredImage;
const imageAlt = entry.data.imageAlt ?? entry.data.title;
const showFeatured = shouldShowFeaturedImage(featuredImage, entry.body);
const ogImage = isUsableFeaturedImage(featuredImage) ? featuredImage : undefined;
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={ogImage}>
  <slot name="header" slot="header" />

  <article class="blog-post">
    <div class="blog-post__layout container">
      <header class="blog-post__header reveal">
        <nav class="page-breadcrumbs" aria-label="Breadcrumb">
          <ol class="page-breadcrumbs__list">
            <li class="page-breadcrumbs__item"><a class="page-breadcrumbs__link" href="/">Home</a></li>
            <li class="page-breadcrumbs__sep" aria-hidden="true">›</li>
            <li class="page-breadcrumbs__item"><a class="page-breadcrumbs__link" href="/blog/">Blog</a></li>
            <li class="page-breadcrumbs__sep" aria-hidden="true">›</li>
            <li class="page-breadcrumbs__item" aria-current="page">
              <span class="page-breadcrumbs__current">{entry.data.title}</span>
            </li>
          </ol>
        </nav>

        <h1>{entry.data.title}</h1>

        <div class="blog-post__meta">
          {entry.data.author && <span class="blog-post__author">{entry.data.author}</span>}
          <time class="blog-post__date" datetime={entry.data.pubDate.toISOString()}>
            {formatDate(entry.data.pubDate)}
          </time>
        </div>

        {entry.data.categories && entry.data.categories.length > 0 && (
          <ul class="blog-post__categories">
            {entry.data.categories.map((category) => (
              <li>{category}</li>
            ))}
          </ul>
        )}
      </header>

      {showFeatured && (
        <div class="blog-post__featured reveal">
          <img
            src={featuredImage}
            alt={imageAlt}
            class="blog-post__image"
            width="1280"
            height="720"
            loading="eager"
          />
        </div>
      )}

      <div class="blog-post__body reveal">
        <slot />
      </div>
    </div>
  </article>

  <slot name="footer" slot="footer" />
</BaseLayout>

<style>
  .blog-post {
    padding-block: clamp(1.75rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .blog-post__layout {
    max-width: min(760px, 100%);
  }


  .blog-post__header h1 {
    font-size: clamp(1.875rem, 4.2vw, 2.75rem);
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
    max-width: 22ch;
  }

  .blog-post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
  }

  .blog-post__author {
    font-family: var(--font-nav);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .blog-post__date {
    font-family: var(--font-nav);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .blog-post__categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .blog-post__categories li {
    font-family: var(--font-nav);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-bg-warm) 55%, var(--color-secondary));
    padding: 0.3rem 0.7rem;
  }

  .blog-post__featured {
    margin-block: 2rem 2.5rem;
  }

  .blog-post__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-bg-warm);
  }

  .blog-post__body {
    font-size: clamp(1rem, 1.4vw, 1.0625rem);
    line-height: 1.75;
  }

  .blog-post__body :global(h2),
  .blog-post__body :global(h3),
  .blog-post__body :global(h4) {
    margin-top: 2.25rem;
    margin-bottom: 0.875rem;
    scroll-margin-top: 1.5rem;
  }

  .blog-post__body :global(p) {
    margin-bottom: 1.25rem;
  }

  .blog-post__body :global(img) {
    max-width: 100%;
    height: auto;
    margin: 1.5rem 0;
  }

  .blog-post__body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-post__body :global(ul),
  .blog-post__body :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
    padding-left: 1rem;
  }

  .blog-post__body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .blog-post__body :global(td),
  .blog-post__body :global(th) {
    border: 1px solid rgba(15, 15, 15, 0.1);
    padding: 0.625rem 0.75rem;
    text-align: left;
    min-width: 120px;
  }

  .blog-post__body :global(blockquote) {
    margin: 1.75rem 0;
    padding: 1rem 0 1rem 1.25rem;
    border-left: 3px solid var(--color-bg-warm);
    font-style: italic;
    color: var(--color-muted);
  }

  @media (max-width: 599px) {
    .blog-post__header h1 {
      max-width: none;
    }

    .blog-post__image {
      aspect-ratio: 4 / 3;
    }

  }
</style>
