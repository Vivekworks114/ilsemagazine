---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const featuredImage = entry.data.featuredImage ?? '/images/2022/Rectangle-1-1.png';
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={featuredImage}>
  <slot name="header" />

  <section class="page-hero section--sm">
    <div class="container reveal">
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p>{entry.data.description}</p>}
    </div>
  </section>

  {featuredImage && (
    <div class="container page-featured reveal">
      <img
        src={featuredImage}
        alt={entry.data.title}
        class="page-featured__image"
        width="1280"
        height="720"
        loading="eager"
      />
    </div>
  )}

  <section class="section page-content">
    <div class="container reveal">
      <div class="page-content__body prose">
        <slot />
      </div>
    </div>
  </section>

  <slot name="footer" />
</BaseLayout>

<style>
  .page-hero {
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero p {
    max-width: 42rem;
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--color-muted);
  }

  .page-featured {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .page-featured__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    box-shadow: var(--shadow-md);
  }

  .page-content__body {
    max-width: 720px;
    margin-inline: auto;
    line-height: 1.8;
    font-size: clamp(1rem, 2vw, 1.0625rem);
  }

  .page-content__body :global(h2),
  .page-content__body :global(h3),
  .page-content__body :global(h4) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .page-content__body :global(p) {
    margin-bottom: 1.25rem;
  }

  .page-content__body :global(img) {
    max-width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border-radius: 2px;
  }

  .page-content__body :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
    word-break: break-word;
  }

  .page-content__body :global(ul),
  .page-content__body :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
    padding-left: 1rem;
  }

  .page-content__body :global(li) {
    margin-bottom: 0.375rem;
  }

  .page-content__body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .page-content__body :global(td),
  .page-content__body :global(th) {
    border: 1px solid rgba(0, 0, 0, 0.12);
    padding: 0.625rem 0.75rem;
    text-align: left;
    min-width: 120px;
  }

  .page-hero h1 {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
  }

  @media (max-width: 599px) {
    .page-featured {
      padding-inline: 0;
    }

    .page-featured__image {
      aspect-ratio: 4 / 3;
    }
  }
</style>
