---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { shouldShowFeaturedImage, isUsableFeaturedImage } from '../lib/featured-image';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const featuredImage = entry.data.featuredImage;
const showFeatured = shouldShowFeaturedImage(featuredImage, entry.body);
const ogImage = isUsableFeaturedImage(featuredImage) ? featuredImage : undefined;
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={ogImage}>
  <slot name="header" slot="header" />

  <article class="content-page">
    <div class="content-page__layout container">
      <header class="content-page__header reveal">
        <nav class="page-breadcrumbs" aria-label="Breadcrumb">
          <ol class="page-breadcrumbs__list">
            <li class="page-breadcrumbs__item"><a class="page-breadcrumbs__link" href="/">Home</a></li>
            <li class="page-breadcrumbs__sep" aria-hidden="true">›</li>
            <li class="page-breadcrumbs__item" aria-current="page">
              <span class="page-breadcrumbs__current">{entry.data.title}</span>
            </li>
          </ol>
        </nav>

        <h1>{entry.data.title}</h1>
        {entry.data.description && <p class="content-page__lead">{entry.data.description}</p>}
      </header>

      {showFeatured && (
        <div class="content-page__featured reveal">
          <img
            src={featuredImage}
            alt={entry.data.title}
            class="content-page__image"
            width="1280"
            height="720"
            loading="eager"
          />
        </div>
      )}

      <div class="content-page__body prose reveal">
        <slot />
      </div>
    </div>
  </article>

  <slot name="footer" slot="footer" />
</BaseLayout>

<style>
  .content-page {
    padding-block: clamp(1.75rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .content-page__layout {
    max-width: min(760px, 100%);
  }


  .content-page__header h1 {
    font-size: clamp(1.875rem, 4.2vw, 2.75rem);
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
    max-width: 22ch;
  }

  .content-page__lead {
    max-width: 42rem;
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0;
  }

  .content-page__featured {
    margin-block: 2rem 2.5rem;
  }

  .content-page__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-bg-warm);
  }

  .content-page__body {
    max-width: none;
    line-height: 1.75;
    font-size: clamp(1rem, 1.4vw, 1.0625rem);
  }

  .content-page__body :global(h2),
  .content-page__body :global(h3),
  .content-page__body :global(h4) {
    margin-top: 2.25rem;
    margin-bottom: 0.875rem;
    line-height: 1.25;
    scroll-margin-top: 1.5rem;
  }

  .content-page__body :global(p) {
    margin-bottom: 1.25rem;
  }

  .content-page__body :global(img) {
    max-width: 100%;
    height: auto;
    margin: 1.5rem 0;
  }

  .content-page__body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    word-break: break-word;
  }

  .content-page__body :global(ul),
  .content-page__body :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
    padding-left: 1rem;
  }

  .content-page__body :global(li) {
    margin-bottom: 0.375rem;
  }

  .content-page__body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .content-page__body :global(td),
  .content-page__body :global(th) {
    border: 1px solid rgba(15, 15, 15, 0.1);
    padding: 0.625rem 0.75rem;
    text-align: left;
    min-width: 120px;
  }

  .content-page__body :global(blockquote) {
    margin: 1.75rem 0;
    padding: 1rem 0 1rem 1.25rem;
    border-left: 3px solid var(--color-bg-warm);
    font-style: italic;
    color: var(--color-muted);
  }

  @media (max-width: 599px) {
    .content-page__header h1 {
      max-width: none;
    }

    .content-page__image {
      aspect-ratio: 4 / 3;
    }

  }
</style>
